<Window x:Class="БД.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Интерфейс базы данных" Height="600" Width="900"
        Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="База данных:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="CmbDatabases" Width="200" Margin="0,0,20,0" SelectionChanged="CmbDatabases_SelectionChanged"/>

            <TextBlock Text="Таблица:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="CmbTables" Width="200" SelectionChanged="CmbTables_SelectionChanged"/>
        </StackPanel>

        <DataGrid x:Name="DgData" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" SelectionMode="Single"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="Добавить запись" Width="150" Height="32" Margin="5" Click="BtnAdd_Click"/>
            <Button Content="Редактировать запись" Width="150" Height="32" Margin="5" Click="BtnEdit_Click"/>
            <Button Content="Удалить запись" Width="150" Height="32" Margin="5" Click="BtnDelete_Click"/>
        </StackPanel>
    </Grid>
</Window>